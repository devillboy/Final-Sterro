{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "runtime": "vercel-node@latest",
      "memory": 1024,
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "cleanUrls": true
}
