{
  "entities": {
    "Plan": {
      "title": "Hosting Plan",
      "description": "Details for a Minecraft or VPS hosting plan",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "ram": { "type": "string" },
        "cpu": { "type": "string" },
        "storage": { "type": "string" },
        "throughput": { "type": "string" },
        "ports": { "type": "string" },
        "type": { "type": "string", "enum": ["minecraft", "vps"] },
        "highlight": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "price", "type"]
    },
    "Asset": {
      "title": "Website Asset",
      "description": "Configurable images or links for the website",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["key", "url"]
    },
    "Admin": {
      "title": "Administrator",
      "description": "Users with access to the admin panel",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    },
    "User": {
      "title": "User Profile",
      "description": "User specific data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" }
      }
    },
    "Subscription": {
      "title": "User Subscription",
      "description": "Record of a purchased or trial plan",
      "type": "object",
      "properties": {
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "price": { "type": "number" },
        "serverName": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "panelUrl": { "type": "string" }
      }
    },
    "PanelSettings": {
      "title": "Panel Credentials",
      "description": "Stored credentials for the Pterodactyl panel",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/plans/{planId}": {
      "schema": "Plan",
      "description": "Available hosting plans"
    },
    "/assets/{assetId}": {
      "schema": "Asset",
      "description": "Website assets like hero image, etc."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "List of authorized administrators"
    },
    "/users/{userId}/settings/panel": {
      "schema": "PanelSettings",
      "description": "User's panel credentials"
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "User's active and past subscriptions"
    },
    "/trials/{email}": {
      "schema": "object",
      "description": "Trial claim records"
    },
    "/otps/{email}": {
      "schema": "object",
      "description": "Verification codes"
    },
    "/transactions/{transactionId}": {
      "schema": "object",
      "description": "Payment and system logs"
    },
    "/payments/{utrId}": {
      "schema": "object",
      "description": "UTR verification tracking"
    },
    "/invoices/{invoiceId}": {
      "schema": "object",
      "description": "Billing records for users"
    }
  }
}
