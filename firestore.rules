rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Path Variable Hardening (Helper)
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // 1. The "Master Gate" (Identity lookup)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "ghoshsima874@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // -- PLAN VALIDATION --
    function isValidPlan(data) {
      return data.keys().hasAll(['name', 'price', 'type']) &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.type in ['minecraft', 'vps'] &&
             (!data.keys().hasAny(['ram']) || (data.ram is string && data.ram.size() <= 50)) &&
             (!data.keys().hasAny(['cpu']) || (data.cpu is string && data.cpu.size() <= 50)) &&
             (!data.keys().hasAny(['storage']) || (data.storage is string && data.storage.size() <= 50)) &&
             (!data.keys().hasAny(['throughput']) || (data.throughput is string && data.throughput.size() <= 50)) &&
             (!data.keys().hasAny(['ports']) || (data.ports is string && data.ports.size() <= 50)) &&
             (!data.keys().hasAny(['highlight']) || data.highlight is bool) &&
             (!data.keys().hasAny(['order']) || data.order is number) &&
             (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 1000));
    }

    // -- ASSET VALIDATION --
    function isValidAsset(data) {
      return data.keys().hasAll(['key', 'url']) &&
             data.key is string && data.key.size() <= 100 &&
             data.url is string && data.url.size() <= 1000 &&
             (!data.keys().hasAny(['label']) || (data.label is string && data.label.size() <= 100));
    }

    // -- PANEL SETTINGS VALIDATION --
    function isValidPanelSettings(data) {
      return data.keys().hasAll(['email', 'username', 'password', 'updatedAt']) &&
             data.email is string && data.username is string &&
             data.password is string && data.updatedAt is timestamp;
    }

    // -- SUBSCRIPTION VALIDATION --
    function isValidSubscription(data) {
      return data.keys().hasAll(['planId', 'planName', 'price', 'serverName', 'status', 'createdAt']) &&
             data.planId is string && data.planName is string &&
             (data.price is number || data.price is string) && data.serverName is string &&
             data.status is string && data.createdAt is timestamp &&
             (!data.keys().hasAny(['panelUrl']) || data.panelUrl is string);
    }

    // -- TRANSACTION VALIDATION --
    function isValidTransaction(data) {
      return data.keys().hasAll(['utrId', 'email', 'status', 'planName']) &&
             data.utrId is string && data.email is string &&
             data.status is string && data.planName is string;
    }

    // -- COLLECTION MATCHES --

    match /plans/{planId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidPlan(request.resource.data) && isValidId(planId);
      allow update: if isAdmin() && isValidPlan(request.resource.data);
      allow delete: if isAdmin();
    }

    match /assets/{assetId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidAsset(request.resource.data) && isValidId(assetId);
      allow update: if isAdmin() && isValidAsset(request.resource.data);
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(adminId);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      match /settings/panel {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId && isValidPanelSettings(request.resource.data);
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidSubscription(request.resource.data);
      }
    }

    match /trials/{email} {
      // Server-side uses Client SDK without auth
      allow read, write: if true; 
    }

    match /otps/{email} {
      // Server-side uses Client SDK without auth
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if true; // Server-side creation
    }

    match /payments/{utrId} {
      allow read: if isAdmin() || true; // Server-side dupe check
      allow write: if true; // Server-side write
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() || true; // Allow users to view their invoices and server to fetch
      allow write: if true; // Server-side write
    }

    // Tracking orders for analytics
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() || true; // Allow server-side
    }
  }
}
